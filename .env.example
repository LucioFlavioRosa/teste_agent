# =============================================================================
# CONFIGURAÇÕES DO AGENT VINNA
# =============================================================================
# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o arquivo .env com credenciais reais!

# =============================================================================
# OPENAI API CONFIGURATION
# =============================================================================
# Sua chave da API OpenAI para usar GPT-4
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo padrão para análises (opcional)
# Opções: gpt-4, gpt-4-turbo, gpt-3.5-turbo
DEFAULT_MODEL=gpt-4

# Máximo de tokens para resposta (opcional)
MAX_TOKENS=3000

# =============================================================================
# GITHUB API CONFIGURATION
# =============================================================================
# Token de acesso pessoal do GitHub para ler repositórios
# Crie em: https://github.com/settings/tokens
# Permissões necessárias: repo (para repositórios privados) ou public_repo
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# FLASK APPLICATION CONFIGURATION
# =============================================================================
# Ambiente de execução da aplicação
# Opções: development, production, testing
FLASK_ENV=development

# Ativar modo debug (apenas para desenvolvimento)
# Opções: True, False
FLASK_DEBUG=True

# Host da aplicação (0.0.0.0 para aceitar conexões externas)
FLASK_HOST=0.0.0.0

# Porta da aplicação
FLASK_PORT=5000

# Chave secreta para sessões Flask (gere uma aleatória para produção)
FLASK_SECRET_KEY=sua-chave-secreta-super-segura-aqui

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Nível de log da aplicação
# Opções: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Arquivo de log (opcional, deixe vazio para log apenas no console)
LOG_FILE=

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# Número máximo de workers para paralelização
MAX_WORKERS=4

# Número máximo de tentativas para retry
MAX_RETRIES=3

# Delay entre tentativas (em segundos)
RETRY_DELAY=2

# Profundidade máxima para leitura de diretórios (opcional)
# Deixe vazio para sem limite
MAX_DEPTH=

# =============================================================================
# GOOGLE COLAB CONFIGURATION (apenas se usando Colab)
# =============================================================================
# Se estiver executando no Google Colab, configure os secrets:
# - OPENAI_API_KEY: Sua chave OpenAI
# - github_token: Seu token GitHub
# 
# Estes valores serão lidos automaticamente via userdata.get()

# =============================================================================
# ANÁLISE CONFIGURATION
# =============================================================================
# Tipos de análise suportados (não modificar)
# SUPPORTED_ANALYSIS_TYPES=design,pentest,seguranca,terraform

# Timeout para chamadas da API OpenAI (em segundos)
OPENAI_TIMEOUT=60

# Timeout para chamadas da API GitHub (em segundos)
GITHUB_TIMEOUT=30

# =============================================================================
# EXEMPLO DE USO
# =============================================================================
# Após configurar as variáveis acima, você pode:
# 
# 1. Executar análise via script:
#    python teste_git_hub.py
# 
# 2. Executar servidor Flask:
#    python teste_git_hub.py
# 
# 3. Fazer requisição para API:
#    curl -X POST http://localhost:5000/executar_analise \
#      -H "Content-Type: application/json" \
#      -d '{"tipo_analise": "pentest", "repositorio": "usuario/repo"}'

# =============================================================================
# SEGURANÇA
# =============================================================================
# IMPORTANTE:
# - Nunca compartilhe suas chaves de API
# - Use tokens com permissões mínimas necessárias
# - Revogue tokens não utilizados
# - Monitore uso das APIs para detectar uso não autorizado
# - Em produção, use variáveis de ambiente do sistema ao invés de arquivos .env