# Exemplo de Variáveis de Ambiente para o Agent Vinna

# OPENAI_API_KEY: Chave de API da OpenAI (obrigatória)
# Obtenha em https://platform.openai.com/account/api-keys
# ATENÇÃO: Use uma chave com permissões restritas e nunca compartilhe publicamente.
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# github_token: Personal Access Token do GitHub (obrigatório)
# Gere em https://github.com/settings/tokens com escopo mínimo necessário (read:repo).
# NUNCA utilize um token com permissões de escrita ou administrativas.
github_token="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Segurança:
# - Nunca commite o arquivo .env real no repositório (adicione ao .gitignore)
# - Armazene as chaves em local seguro e rotacione periodicamente
