# Exemplo de arquivo .env para configuração do ambiente

# Token de acesso pessoal do GitHub (obrigatório para análises em repositórios privados ou alto volume)
GITHUB_TOKEN=seu_token_aqui  # Obtenha em https://github.com/settings/tokens

# Ambiente do Flask (development ou production)
FLASK_ENV=development

# Ativa/desativa debug do Flask
FLASK_DEBUG=True

# Porta para execução da API
API_PORT=5000
