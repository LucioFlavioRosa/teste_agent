# =============================================================================
# CONFIGURAÇÕES DE API - Agent Vinna
# =============================================================================
# Copie este arquivo para .env e preencha com seus tokens reais

# GitHub API Token
# Obtenha em: https://github.com/settings/tokens
# Permissões necessárias: repo (read)
GITHUB_TOKEN=ghp_exemplo1234567890abcdefghijklmnopqrstuvwxyz

# OpenAI API Key
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-exemplo1234567890abcdefghijklmnopqrstuvwxyzABCDEF

# =============================================================================
# CONFIGURAÇÕES DO SERVIDOR
# =============================================================================

# Porta do servidor Flask (padrão: 5000)
PORT=5000

# Host do servidor (padrão: 0.0.0.0 para aceitar conexões externas)
HOST=0.0.0.0

# Modo debug (true/false)
DEBUG=true

# =============================================================================
# CONFIGURAÇÕES DE ANÁLISE
# =============================================================================

# Modelo padrão para análises LLM
MODELO_PADRAO_LLM=gpt-4.1

# Máximo de tokens na saída
MAX_TOKENS_SAIDA=3000

# Máximo de workers para paralelismo
MAX_PARALLELISM=4

# Máximo de tentativas para retry
MAX_RETRIES=3

# Delay entre tentativas (segundos)
RETRY_DELAY=2

# =============================================================================
# CONFIGURAÇÕES DE LOGGING
# =============================================================================

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Formato do log
LOG_FORMAT='%(asctime)s %(levelname)s %(message)s'

# =============================================================================
# CONFIGURAÇÕES OPCIONAIS
# =============================================================================

# Profundidade máxima para leitura de diretórios (opcional)
# MAX_DEPTH=10

# Timeout para requisições HTTP (segundos)
# HTTP_TIMEOUT=30

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
# 
# 1. NUNCA commite o arquivo .env com tokens reais
# 2. Mantenha seus tokens seguros e não os compartilhe
# 3. Regenere tokens se suspeitar de comprometimento
# 4. Use tokens com permissões mínimas necessárias
# 5. Para produção, considere usar serviços de gerenciamento de secrets